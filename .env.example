# NalaSetu AWS API Gateway base URL
# Replace with your deployed API Gateway URL.
VITE_NALASETU_API_URL=https://o39m3kgdyb.execute-api.us-east-1.amazonaws.com

# S3 Bucket for Proof Photos (Backend only)
